#!/bin/sh
set -e
DRV=nimo-wmi
DRV_VERSION=@DRV_VERSION@

if [ "$1" = configure ]; then
	# The group that may change the settings without a password: the machine's
	# admins, plus whoever ran "sudo apt install".
	groupadd -f -r nimo
	for u in $(getent group sudo | cut -d: -f4 | tr ',' ' ') ${SUDO_USER:-}; do
		[ "$u" != root ] && id "$u" >/dev/null 2>&1 && usermod -aG nimo "$u" || true
	done

	# Build and install the driver for the running kernel (and future ones).
	if ! dkms status -m "$DRV" -v "$DRV_VERSION" | grep -q .; then
		dkms add -m "$DRV" -v "$DRV_VERSION"
	fi
	dkms install -m "$DRV" -v "$DRV_VERSION" || echo "nimo-wmi: DKMS couldn't build the driver; see the output above." >&2

	udevadm control --reload || true
	load_failed() {
		if command -v mokutil >/dev/null && mokutil --sb-state 2>/dev/null | grep -q "SecureBoot enabled"; then
			echo "nimo-wmi: Secure Boot is on. Enroll DKMS's signing key, then reboot:" >&2
			echo "    sudo mokutil --import /var/lib/shim-signed/mok/MOK.der" >&2
			echo "  pick a one-time password; after the reboot choose Enroll MOK, Continue, Yes, type it, Reboot." >&2
		else
			echo "nimo-wmi: the driver didn't load (this isn't a NIMO AXIS 395?). 'dmesg | grep nimo' says why." >&2
		fi
	}
	if [ -d /sys/module/nimo_wmi ]; then
		# An upgrade leaves the old build running. Switch to the new one, but only
		# once it's installed for this kernel: after a failed build, unloading
		# would leave no driver at all. srcversion also catches a same-version rebuild.
		running=$(cat /sys/module/nimo_wmi/srcversion 2>/dev/null || true)
		if dkms status -m "$DRV" -v "$DRV_VERSION" -k "$(uname -r)" 2>/dev/null | grep -q ': installed' &&
			[ "$(modinfo -F version nimo_wmi 2>/dev/null || true)" = "$DRV_VERSION" ]; then
			built=$(modinfo -F srcversion nimo_wmi 2>/dev/null || true)
			if [ -n "$built" ] && [ "$built" != "$running" ]; then
				if modprobe -r "$DRV" 2>/dev/null; then
					modprobe "$DRV" 2>/dev/null || load_failed
				else
					echo "nimo-wmi: the old driver is still running; reboot to finish." >&2
				fi
			fi
		else
			echo "nimo-wmi: the old driver is still running; reboot to finish." >&2
		fi
	elif ! modprobe "$DRV" 2>/dev/null; then
		load_failed
	fi
	# TUXEDO's ite_829x also claims this keyboard and resets its lighting. install.sh offers to block it.
	if [ -d /sys/module/ite_829x ] && [ ! -e /etc/modprobe.d/nimo-block-ite_829x.conf ]; then
		printf '%s\n' "nimo-wmi: TUXEDO's ite_829x driver (part of tuxedo-drivers, made for TUXEDO laptops) is" \
			"  loaded. It also takes over this NIMO's keyboard lighting: when it starts and after every" \
			"  suspend it turns the light off and the keys white. Nothing on this laptop needs it, and" \
			"  blocking it leaves the rest of tuxedo-drivers working. To block it, put these two lines in" \
			"  /etc/modprobe.d/nimo-block-ite_829x.conf and reboot (the install.sh one-liner offers to do it):" \
			"    blacklist ite_829x" "    install ite_829x /bin/false" \
			"  To undo it, delete that file and reboot." >&2
	fi
	# Show the power modes in the desktop's power menu.
	if systemctl is-active -q power-profiles-daemon 2>/dev/null; then
		systemctl restart power-profiles-daemon || true
	fi
	if command -v gtk-update-icon-cache >/dev/null; then
		gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true
	fi
	# From 1.2.3 a running app switches to the upgraded file by itself. Older copies
	# don't: close them, and start the new app in each of those users' trays
	# (best effort; otherwise it starts at their next login).
	if [ -n "${2:-}" ] && dpkg --compare-versions "$2" lt 1.2.3; then
		APP_CMD='[^ ]*nimo-control-center( --replaced)?( --tray)?'
		users=$(for pid in $(pgrep -x -f "$APP_CMD"); do
			getent passwd "$(ps -o uid= -p "$pid" | tr -d ' ')" | cut -d: -f1
		done | sort -u)
		if [ -n "$users" ]; then
			pkill -x -f "$APP_CMD" || true
			for u in $users; do
				systemd-run --user --machine="$u@" --collect --quiet \
					/usr/bin/nimo-control-center-launch --tray >/dev/null 2>&1 || true
			done
		fi
	fi
fi
exit 0
