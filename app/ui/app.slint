// NIMO Control Center for Linux: the four pages of NIMO's Windows Control Center
// (Dashboard, System Information, Lighting Setting, Power Mode), same layout and
// look, plus a few extras. Logic is in src/main.rs; everything here scales with
// the window.

import { ComboBox, LineEdit, Slider } from "std-widgets.slint";

export struct KeyCap {
    x: float,     // Control Center key-map units (keyboard is 1371 x 500)
    y: float,
    w: float,
    h: float,
    zone: int,    // lighting zone 0-3
    label: string,
    sub: string,
    idx: int,
    icon: image,
    has-icon: bool,
}

global Theme {
    out property <color> bg: #05090b;
    out property <brush> page: @radial-gradient(circle, #0c2a2f 0%, #061114 55%, #05090b 100%);
    out property <brush> sidebar: @linear-gradient(180deg, #0b1418 0%, #0a1316 60%, #0d1c22 100%);
    out property <color> accent: #1fe0dc;
    out property <color> accent-dim: #12807e;
    out property <brush> accent-grad: @linear-gradient(90deg, #12d6d3 0%, #0d8c8f 70%, #0b3b40 100%);
    out property <color> text: #eef6f7;
    out property <color> muted: #8aa1a6;
    out property <color> line: #1d4046;
    out property <color> panel: #0f1d22;
}

// ---- small building blocks -------------------------------------------------------

component SectionHeader inherits HorizontalLayout {
    in property <image> icon;
    in property <string> title;
    in property <string> subtitle;
    spacing: 12px;
    height: 40px;
    Image {
        source: icon;
        colorize: Theme.text;
        width: 24px;
        height: 24px;
        y: (parent.height - self.height) / 2;
    }
    Text {
        text: title;
        color: Theme.text;
        font-size: 18px;
        vertical-alignment: center;
    }
    if subtitle != "": Text {
        text: "    " + subtitle;
        color: Theme.text;
        font-size: 18px;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        horizontal-stretch: 1;
        min-width: 20px;
        Rectangle {
            y: parent.height / 2;
            height: 1px;
            background: @linear-gradient(90deg, Theme.line 0%, transparent 100%);
        }
    }
}

component NavButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected;
    callback clicked;
    height: 64px;
    background: selected ? Theme.accent-grad : touch.has-hover ? #ffffff08 : transparent;
    HorizontalLayout {
        padding-left: 30px;
        spacing: 20px;
        alignment: start;
        Image {
            source: icon;
            colorize: Theme.text;
            width: 30px;
            height: 30px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: 18px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Control Center's ON/OFF pill toggle.
component Toggle inherits HorizontalLayout {
    in-out property <bool> checked;
    callback toggled(bool);
    spacing: 8px;
    alignment: start;
    Rectangle {
        width: 50px;
        height: 24px;
        y: (parent.height - self.height) / 2;
        border-radius: 12px;
        border-width: 2px;
        border-color: checked ? Theme.accent : Theme.muted;
        background: checked ? #1fe0dc22 : transparent;
        Rectangle {
            width: 12px;
            height: 12px;
            border-radius: 6px;
            border-width: 2px;
            border-color: checked ? Theme.accent : Theme.muted;
            x: checked ? parent.width - self.width - 7px : 7px;
            y: (parent.height - self.height) / 2;
            animate x { duration: 120ms; }
        }
        TouchArea {
            clicked => {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }
    Text {
        text: checked ? "ON" : "OFF";
        color: Theme.text;
        font-size: 17px;
        vertical-alignment: center;
        width: 40px;
    }
}

component PillButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> selected;
    in property <color> glow: Theme.accent;
    in property <color> icon-colour: Theme.text;
    in property <length> font-size: 16px;
    callback clicked;
    min-height: 48px;
    min-width: 120px;
    border-radius: self.height / 2;
    border-width: 1.5px;
    border-color: selected ? glow : touch.has-hover ? Theme.accent : Theme.line;
    background: selected ? @linear-gradient(90deg, glow.with-alpha(0.05) 0%, glow.with-alpha(0.45) 50%, glow.with-alpha(0.05) 100%) : touch.has-hover ? #ffffff08 : transparent;
    drop-shadow-blur: selected ? 16px : 0px;
    drop-shadow-color: glow.with-alpha(0.35);
    animate background, border-color { duration: 150ms; }
    HorizontalLayout {
        alignment: center;
        spacing: 10px;
        padding-left: 14px;
        padding-right: 14px;
        if has-icon: Image {
            source: icon;
            colorize: icon-colour;
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: root.font-size;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// ---- dashboard instruments -------------------------------------------------------

// Frequency dial with a needle, 0-6000 MHz like Control Center.
component NeedleGauge inherits Rectangle {
    in property <float> value;
    in property <float> maximum: 6000;
    in property <string> caption;
    property <float> frac: Math.max(0, Math.min(1, value / maximum));
    property <angle> needle: 135deg + 270deg * frac;
    property <length> size: Math.max(90px, Math.min(self.width, self.height - 34px));
    min-width: 120px;
    min-height: 150px;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    dial := Rectangle {
        width: size;
        height: size;
        x: (parent.width - size) / 2;
        Rectangle {
            border-radius: self.width / 2;
            background: @radial-gradient(circle, #0c2329 0%, #081619 70%, transparent 100%);
            border-width: 1px;
            border-color: #14363b;
        }
        Path {
            viewbox-width: 100;
            viewbox-height: 100;
            fill: transparent;
            stroke: Theme.accent-dim;
            stroke-width: 2px;
            commands: "M 23.48 76.52 A 37.5 37.5 0 1 1 76.52 76.52";
        }
        Path {
            viewbox-width: 100;
            viewbox-height: 100;
            fill: transparent;
            stroke: @linear-gradient(90deg, #b5ff3a 0%, Theme.accent 100%);
            stroke-width: 3px;
            commands: frac < 0.002 ? "" : "M 23.48 76.52 A 37.5 37.5 0 " + (frac > 0.6667 ? "1" : "0") + " 1 " + (50 + 37.5 * Math.cos(needle)) + " " + (50 + 37.5 * Math.sin(needle));
        }
        for i in 7: Text {
            property <angle> a: 135deg + 45deg * i;
            x: parent.width / 2 + parent.width * 0.29 * Math.cos(a) - self.width / 2;
            y: parent.height / 2 + parent.height * 0.29 * Math.sin(a) - self.height / 2;
            text: Math.round(maximum / 6 * i);
            color: Theme.muted;
            font-size: Math.max(8px, size / 20);
        }
        Path {
            viewbox-width: 100;
            viewbox-height: 100;
            stroke: Theme.accent;
            stroke-width: 3px;
            commands: "M 50 50 L " + (50 + 30 * Math.cos(needle)) + " " + (50 + 30 * Math.sin(needle));
        }
        Rectangle {
            width: size / 9;
            height: size / 9;
            border-radius: self.width / 2;
            border-width: 3px;
            border-color: Theme.accent;
            background: Theme.bg;
        }
        Text {
            y: parent.height * 0.79;
            width: 100%;
            horizontal-alignment: center;
            text: Math.round(value) + " MHz";
            color: Theme.text;
            font-size: Math.max(10px, size / 15);
        }
    }
    Text {
        y: parent.height - 28px;
        width: 100%;
        horizontal-alignment: center;
        text: caption;
        color: Theme.text;
        font-size: 17px;
    }
}

component Thermometer inherits Rectangle {
    in property <float> value;   // °C
    property <float> frac: Math.max(0.05, Math.min(1, value / 100));
    property <length> tube: Math.max(60px, self.height - 34px);
    min-width: 60px;
    min-height: 150px;
    horizontal-stretch: 0.6;
    Rectangle {
        x: (parent.width - 18px) / 2;
        y: tube * 0.1;
        width: 18px;
        height: tube * 0.8;
        border-radius: 9px;
        border-width: 2px;
        border-color: Theme.accent;
        Rectangle {
            x: 5px;
            width: 8px;
            y: parent.height - self.height - 4px;
            height: (parent.height - 8px) * frac;
            border-radius: 4px;
            background: @linear-gradient(0deg, Theme.accent 0%, #b5ff3a 100%);
            animate height { duration: 400ms; }
        }
    }
    Rectangle {
        x: (parent.width - 26px) / 2;
        y: tube * 0.9 - 6px;
        width: 26px;
        height: 26px;
        border-radius: 13px;
        border-width: 3px;
        border-color: Theme.accent;
        background: Theme.bg;
    }
    Text {
        y: parent.height - 28px;
        width: 100%;
        horizontal-alignment: center;
        text: Math.round(value) + "°C";
        color: Theme.text;
        font-size: 17px;
    }
}

// Percentage ring (Usage, Battery, Memory, Storage).
component Ring inherits Rectangle {
    in property <float> value;   // 0-100
    in property <string> caption;
    property <float> frac: Math.max(0, Math.min(1, value / 100));
    property <angle> end: -90deg + 360deg * frac;
    property <length> size: Math.max(80px, Math.min(self.width, self.height - 34px));
    min-width: 110px;
    min-height: 150px;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    Rectangle {
        width: size;
        height: size;
        x: (parent.width - size) / 2;
        Rectangle {
            border-radius: self.width / 2;
            border-width: 1px;
            border-color: #14363b;
            background: @radial-gradient(circle, #0c2329 0%, #081619 75%, transparent 100%);
        }
        Rectangle {
            width: parent.width * 0.62;
            height: parent.height * 0.62;
            border-radius: self.width / 2;
            background: #173a42;
            drop-shadow-blur: 10px;
            drop-shadow-color: #0008;
        }
        Path {
            viewbox-width: 100;
            viewbox-height: 100;
            fill: transparent;
            stroke: #ffffff10;
            stroke-width: size / 16;
            commands: "M 50 13 A 37 37 0 1 1 49.99 13";
        }
        if frac > 0.002 && frac < 0.999: Path {
            viewbox-width: 100;
            viewbox-height: 100;
            fill: transparent;
            stroke: @linear-gradient(90deg, #b5ff3a 0%, Theme.accent 100%);
            stroke-width: size / 16;
            commands: "M 50 13 A 37 37 0 " + (frac > 0.5 ? "1" : "0") + " 1 " + (50 + 37 * Math.cos(end)) + " " + (50 + 37 * Math.sin(end));
        }
        if frac >= 0.999: Rectangle {
            width: parent.width * 0.74 + size / 16;
            height: self.width;
            border-radius: self.width / 2;
            border-width: size / 16;
            border-color: #7ef08a;
        }
        Text {
            text: Math.round(value) + "%";
            color: Theme.text;
            font-size: Math.max(11px, size / 9);
        }
    }
    Text {
        y: parent.height - 28px;
        width: 100%;
        horizontal-alignment: center;
        text: caption;
        color: Theme.text;
        font-size: 17px;
    }
}

component QuickRow inherits HorizontalLayout {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled(bool);
    height: 46px;
    Text {
        text: root.text;
        color: Theme.text;
        font-size: 17px;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    Toggle {
        width: 110px;
        checked <=> root.checked;
        toggled(v) => { root.toggled(v); }
    }
}

// ---- lighting ---------------------------------------------------------------------

// The keyboard, drawn from Control Center's own key map. Keys glow in their zone's
// colour; effects are previewed with an animation.
component KeyboardView inherits Rectangle {
    in property <[KeyCap]> keys;
    in property <[color]> zones;
    in property <bool> lit;
    in property <int> brightness;
    in property <int> effect;
    in property <int> speed;
    in property <int> selected;
    in property <bool> animate-preview;
    callback key-clicked(int);
    property <float> scale: Math.min(self.width / 1371px, self.height / 500px);
    property <length> u: scale * 1px;
    property <length> ox: (self.width - 1371 * u) / 2;
    property <length> oy: (self.height - 500 * u) / 2;
    property <float> t: (animate-preview && lit && effect != 0 ? animation-tick() : 0ms) / 1s;
    property <float> spd: 0.35 + speed * 0.13;
    property <float> base: lit ? 0.35 + 0.65 * brightness / 10 : 0.0;
    min-height: 200px;
    vertical-stretch: 1;

    // The real keyboard lights 4 zones, not single keys, so every effect is
    // previewed zone by zone.
    pure function key-colour(k: KeyCap) -> color {
        if effect == 4 {
            return hsv(Math.mod(t * 50 * spd, 360), 1, 1);
        }
        if effect == 2 || effect == 7 {
            return hsv(Math.mod(k.zone * 90 - t * (effect == 2 ? 90 : 140) * spd + 720000, 360), 1, 1);
        }
        if effect == 1 {
            return hsv(Math.mod(k.zone * 97 + Math.floor(t * 0.4 * spd + k.zone * 0.37) * 137, 360), 0.9, 1);
        }
        if effect == 8 {
            return hsv(k.zone * 90, 1, 1);
        }
        return zones[k.zone];
    }
    pure function key-level(k: KeyCap) -> float {
        if effect == 3 {
            return 0.12 + 0.88 * Math.abs(Math.sin(t * 90deg * spd));
        }
        if effect == 1 {
            return Math.max(0.06, Math.pow(Math.max(0, Math.sin(t * 72deg * spd + k.zone * 113deg)), 3));
        }
        if effect == 5 || effect == 6 || effect == 8 {
            return 0.12;
        }
        return 1;
    }

    for k in keys: Rectangle {
        property <color> c: key-colour(k);
        property <float> lv: base * key-level(k);
        property <bool> sel: selected == k.zone;
        x: ox + k.x * u;
        y: oy + k.y * u;
        width: k.w * u;
        height: k.h * u;
        border-radius: 5px * scale * 1.4;
        background: lit ? c.with-alpha(0.10 * lv) : #0b1114;
        border-width: sel ? 2.5px : 1.5px;
        border-color: lit ? (sel ? #ffffff : c.with-alpha(0.25 + 0.75 * lv)) : #23343a;
        drop-shadow-blur: lit ? 8px * lv : 0px;
        drop-shadow-color: c.with-alpha(0.55 * lv);
        property <color> ink: lit ? c.mix(#ffffff, 0.35).with-alpha(0.35 + 0.65 * lv) : #43575d;
        property <bool> short: k.h < 40;
        // Keycap icons: F-keys get the icon left of centre with "F1" in the corner,
        // like the real keys; others get it centred.
        if k.has-icon: Image {
            source: k.icon;
            colorize: ink;
            height: Math.min(parent.height * (short ? 0.62 : 0.5), parent.width * 0.7);
            width: self.height;
            x: short && k.label != "" ? parent.width * 0.16 : (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
        // Top row text keys (Esc, PrtSc, Insert, Delete).
        if short && !k.has-icon: Text {
            text: k.sub != "" ? k.sub : k.label;
            color: ink;
            font-size: Math.max(5px, Math.min((k.sub != "" ? 10px : 13px) * scale * 1.25, (parent.width - 6px) / Math.max(1, (k.sub != "" ? k.sub : k.label).character-count) * 1.7));
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width - 4px;
            overflow: elide;
        }
        if short && k.has-icon && k.label != "": Text {
            x: parent.width - self.width - 3px;
            y: parent.height - self.height - 1px;
            text: k.label;
            color: ink.with-alpha(0.7);
            font-size: Math.max(5px, 8px * scale * 1.25);
        }
        // Tall keys with two legends: upper-left and lower-left, like the keycaps.
        if !short && k.sub != "": Text {
            x: 9px * scale * 1.3;
            y: parent.height * 0.08;
            text: k.label;
            color: ink;
            font-size: Math.max(7px, (k.label.character-count > 2 ? 13px : 22px) * scale * 1.15);
        }
        if !short && k.sub != "": Text {
            x: 9px * scale * 1.3;
            y: parent.height * 0.54;
            text: k.sub;
            color: ink.with-alpha(0.8);
            font-size: Math.max(6px, (k.sub.character-count > 2 ? 10px : 20px) * scale * 1.15);
        }
        if !short && k.sub == "" && !k.has-icon: Text {
            text: k.label;
            font-italic: k.label == "Fn";
            color: ink;
            font-size: Math.max(6px, Math.min((k.label.character-count > 2 ? 14px : 24px) * scale * 1.15, (parent.width - 6px) / Math.max(1, k.label.character-count) * 1.45));
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width - 4px;
            overflow: elide;
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.key-clicked(k.zone); }
        }
    }
}

// Hue/saturation wheel; picks are reported as colours.
component ColourWheel inherits Rectangle {
    in property <color> colour;
    callback picked(color);
    property <length> d: Math.min(self.width, self.height);
    property <float> hue: colour.to-hsv().hue;
    property <float> sat: colour.to-hsv().saturation;
    min-width: 150px;
    min-height: 150px;
    wheel := Rectangle {
        width: d;
        height: d;
        x: (parent.width - d) / 2;
        y: (parent.height - d) / 2;
        border-radius: d / 2;
        background: @conic-gradient(#ff0000 0deg, #ffff00 60deg, #00ff00 120deg, #00ffff 180deg, #0000ff 240deg, #ff00ff 300deg, #ff0000 360deg);
        // White only near the middle: the outer two thirds are full-strength colour.
        Rectangle {
            border-radius: d / 2;
            background: @radial-gradient(circle, #ffffff 0%, #ffffffb0 12%, #ffffff00 55%, #ffffff00 100%);
        }
        Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 8px;
            border-width: 2px;
            border-color: #ffffff;
            background: colour;
            x: d / 2 + Math.sin(hue * 1deg) * Math.min(1, sat * 0.55 + (sat >= 0.999 ? 0.3 : 0)) * d / 2 - 8px;
            y: d / 2 - Math.cos(hue * 1deg) * Math.min(1, sat * 0.55 + (sat >= 0.999 ? 0.3 : 0)) * d / 2 - 8px;
            drop-shadow-blur: 4px;
            drop-shadow-color: #000a;
        }
        TouchArea {
            mouse-cursor: crosshair;
            clicked => {
                root.pick(self.mouse-x - d / 2, self.mouse-y - d / 2);
            }
            moved => {
                if self.pressed {
                    root.pick(self.mouse-x - d / 2, self.mouse-y - d / 2);
                }
            }
        }
    }
    function pick(dx: length, dy: length) {
        // Hue clockwise from the top, like the conic gradient; saturation by distance.
        // Matches the gradient: fully saturated from 55% of the radius outwards.
        root.picked(hsv(Math.mod(Math.atan2(dx / 1px, -dy / 1px) / 1deg + 360, 360), Math.min(1, Math.sqrt(dx * dx / 1px / 1px + dy * dy / 1px / 1px) / (d / 2 / 1px) / 0.55), 1));
    }
}

component RgbBox inherits LineEdit {
    width: 76px;
    horizontal-alignment: center;
    input-type: number;
}

// One of your own presets: click to apply, × to delete.
component UserPresetChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    callback deleted;
    min-height: 40px;
    min-width: 90px;
    border-radius: self.height / 2;
    border-width: 1.5px;
    border-color: selected ? Theme.accent : touch.has-hover ? Theme.accent : Theme.line;
    background: selected ? @linear-gradient(90deg, #1fe0dc0d 0%, #1fe0dc70 50%, #1fe0dc0d 100%) : transparent;
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 6px;
        spacing: 6px;
        Text {
            text: root.text;
            color: Theme.text;
            font-size: 15px;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle {
            width: 26px;
            height: 26px;
            y: (parent.height - self.height) / 2;
            border-radius: 13px;
            background: x-touch.has-hover ? #ff5c6c50 : transparent;
            Text {
                text: "×";
                color: x-touch.has-hover ? #ffffff : Theme.muted;
                font-size: 18px;
            }
            x-touch := TouchArea {
                clicked => { root.deleted(); }
            }
        }
    }
}

// ---- power mode ------------------------------------------------------------------

component FanDial inherits Rectangle {
    in property <float> rpm;
    in property <string> caption;
    property <float> frac: Math.max(0, Math.min(1, rpm / 6000));
    property <length> size: Math.max(120px, Math.min(self.width - 90px, self.height - 70px));
    property <float> spin: (rpm > 50 ? animation-tick() : 0ms) / 1ms;
    min-width: 230px;
    min-height: 230px;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    Rectangle {
        width: size;
        height: size;
        x: (parent.width - size) / 2;
        y: (parent.height - size) / 2;
        Rectangle {
            border-radius: self.width / 2;
            border-width: 1.5px;
            border-color: #1b4a50;
        }
        Path {
            viewbox-width: 100;
            viewbox-height: 100;
            fill: transparent;
            stroke: Theme.accent;
            stroke-width: 4px;
            commands: frac < 0.002 ? "" : "M 50 96 A 46 46 0 " + (frac > 0.5 ? "1" : "0") + " 1 " + (50 + 46 * Math.cos(90deg + 360deg * frac)) + " " + (50 + 46 * Math.sin(90deg + 360deg * frac));
        }
        Rectangle {
            width: parent.width * 0.78;
            height: self.width;
            border-radius: self.width / 2;
            border-width: 6px;
            border-color: #0f2e34;
            background: @radial-gradient(circle, #0f3238 0%, #071417 100%);
        }
        Rectangle {
            width: parent.width * 0.5;
            height: self.width;
            border-radius: self.width / 2;
            background: #122b33;
            drop-shadow-blur: 22px;
            drop-shadow-color: #1fe0dc40;
            Image {
                source: @image-url("icons/fan.svg");
                width: parent.width * 0.78;
                height: self.width;
                transform-rotation: Math.mod(spin * rpm / 60000 * 0.35, 1) * 360deg;
            }
        }
    }
    Text { text: "3000"; color: Theme.text; font-size: 17px; x: (parent.width - self.width) / 2; y: (parent.height - size) / 2 - 30px; }
    Text { text: "0"; color: Theme.text; font-size: 17px; x: (parent.width - self.width) / 2; y: (parent.height + size) / 2 + 8px; }
    Text { text: "1500"; color: Theme.text; font-size: 17px; x: (parent.width - size) / 2 - self.width - 10px; y: (parent.height - self.height) / 2; }
    Text { text: "4500"; color: Theme.text; font-size: 17px; x: (parent.width + size) / 2 + 10px; y: (parent.height - self.height) / 2; }
}

component SpeedCard inherits Rectangle {
    in property <string> title;
    in property <float> rpm;
    border-radius: 20px;
    background: @linear-gradient(135deg, #1d4e57 0%, #15323b 55%, #162a35 100%);
    min-width: 220px;
    min-height: 150px;
    VerticalLayout {
        padding: 26px;
        spacing: 10px;
        alignment: center;
        Text { text: title; color: Theme.text; font-size: 20px; }
        Text { text: Math.round(rpm) + " RPM"; color: Theme.accent; font-size: 30px; font-weight: 700; }
        Text { text: "Usage " + Math.round(Math.min(100, rpm / 60)) + "%"; color: Theme.muted; font-size: 18px; }
    }
}

// ---- window ----------------------------------------------------------------------

export component AppWindow inherits Window {
    title: "NIMO Control Center";
    icon: @image-url("icon.svg");
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 1120px;
    min-height: 760px;
    background: Theme.bg;
    default-font-size: 15px;

    // ---- state (set from Rust) ----
    in-out property <int> page: 0;
    in property <string> version;
    in property <bool> driver-ok: true;
    in property <string> status;
    // dashboard
    in property <string> cpu-name;
    in property <string> gpu-name;
    in property <float> cpu-mhz;
    in property <float> cpu-temp;
    in property <float> cpu-usage;
    in property <float> gpu-mhz;
    in property <float> gpu-temp;
    in property <float> gpu-usage;
    in property <float> battery;
    in property <float> memory;
    in property <float> storage;
    in-out property <bool> speaker-mute;
    in-out property <bool> touchpad: true;
    in-out property <bool> win-key: true;
    in-out property <bool> prtsc-key: true;
    in-out property <bool> fn-key: true;
    // system information
    in property <string> hostname;
    in property <string> model;
    in property <string> board;
    in property <string> display;
    in property <string> audio;
    in property <string> battery-capacity;
    in property <string> os;
    in property <string> memory-size;
    in property <string> storage-size;
    in property <string> network;
    in property <string> battery-level;
    // lighting
    in-out property <bool> light-on: true;
    in-out property <int> brightness: 8;
    in-out property <int> effect: 0;
    in-out property <int> speed: 5;
    in-out property <int> sleep-index: 8;
    in property <[KeyCap]> keys;
    in-out property <[color]> zones: [#ff8000, #ffe600, #00e040, #0080ff];
    in-out property <[color]> bars: [#ff0000, #8000ff];
    in-out property <int> selected-zone: -1;   // -1 all, 0-3 zone, 4/5 light bar
    in-out property <int> preset: 0;
    in property <[string]> user-presets;
    in-out property <int> user-preset: -1;
    in-out property <color> current-colour: #ff8000;
    // power
    in property <float> fan1;
    in property <float> fan2;
    in-out property <int> profile: 1;
    in-out property <bool> limit-charge: false;
    in-out property <int> charge-limit: 80;

    // ---- actions (handled in Rust) ----
    callback set-profile(int);
    callback set-light-on(bool);
    callback set-brightness(int);
    callback set-effect(int);
    callback set-speed(int);
    callback set-sleep(int);
    callback set-preset(int);
    callback set-colour(color);
    callback paint-target(int);          // key or light bar clicked
    callback rgb-entered(string, string, string);
    callback set-key(int, bool);
    callback set-speaker-mute(bool);
    callback set-touchpad(bool);
    callback set-charge-limit(bool, int);
    callback lighting-default();
    callback save-preset(string);
    callback apply-user-preset(int);
    callback delete-user-preset(int);

    HorizontalLayout {
        // ---- sidebar ----
        Rectangle {
            width: 300px;
            background: Theme.sidebar;
            VerticalLayout {
                padding-top: 70px;
                spacing: 6px;
                VerticalLayout {
                    padding-bottom: 70px;
                    spacing: 8px;
                    Text {
                        text: "Control Center";
                        color: Theme.text;
                        font-size: 30px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Version:  " + version;
                        color: Theme.muted;
                        font-size: 15px;
                        horizontal-alignment: center;
                    }
                }
                NavButton {
                    text: "Dashboard";
                    icon: @image-url("icons/dashboard.svg");
                    selected: page == 0;
                    clicked => { page = 0; }
                }
                NavButton {
                    text: "System Information";
                    icon: @image-url("icons/sysinfo.svg");
                    selected: page == 1;
                    clicked => { page = 1; }
                }
                NavButton {
                    text: "Lighting Setting";
                    icon: @image-url("icons/lighting.svg");
                    selected: page == 2;
                    clicked => { page = 2; }
                }
                NavButton {
                    text: "Power Mode";
                    icon: @image-url("icons/power.svg");
                    selected: page == 3;
                    clicked => { page = 3; }
                }
                Rectangle { vertical-stretch: 1; }
                Text {
                    text: driver-ok ? "● nimo-wmi driver connected" : "● nimo-wmi driver not loaded";
                    color: driver-ok ? #2be3a0 : #ff5c6c;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
                Rectangle { height: 18px; }
            }
        }

        // ---- page ----
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.page;
            VerticalLayout {
                padding: 40px;
                padding-top: 34px;
                padding-bottom: 16px;
                spacing: 16px;

                if !driver-ok: Rectangle {
                    height: 44px;
                    border-radius: 10px;
                    background: #3a1a20;
                    Text {
                        text: "The nimo-wmi driver isn't loaded, so most controls won't work. Run install.sh, then reboot.";
                        color: #ffd4d8;
                    }
                }

                // ===== Dashboard =====
                if page == 0: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 24px;
                    HorizontalLayout {
                        vertical-stretch: 1;
                        preferred-height: 2000px;
                        min-height: 300px;
                        spacing: 50px;
                        VerticalLayout {
                            spacing: 18px;
                            SectionHeader {
                                icon: @image-url("icons/cpu.svg");
                                title: "CPU";
                                subtitle: cpu-name;
                            }
                            HorizontalLayout {
                                vertical-stretch: 1;
                                spacing: 10px;
                                NeedleGauge { value: cpu-mhz; caption: "Frequency"; }
                                Thermometer { value: cpu-temp; }
                                Ring { value: cpu-usage; caption: "Usage"; }
                            }
                        }
                        VerticalLayout {
                            spacing: 18px;
                            SectionHeader {
                                icon: @image-url("icons/overview.svg");
                                title: "Overview";
                            }
                            HorizontalLayout {
                                vertical-stretch: 1;
                                spacing: 10px;
                                Ring { value: battery; caption: "Battery"; }
                                Ring { value: memory; caption: "Memory"; }
                                Ring { value: storage; caption: "Storage"; }
                            }
                        }
                    }
                    HorizontalLayout {
                        vertical-stretch: 1;
                        preferred-height: 2000px;
                        min-height: 300px;
                        spacing: 50px;
                        VerticalLayout {
                            spacing: 18px;
                            SectionHeader {
                                icon: @image-url("icons/gpu.svg");
                                title: "GPU";
                                subtitle: gpu-name;
                            }
                            HorizontalLayout {
                                vertical-stretch: 1;
                                spacing: 10px;
                                NeedleGauge { value: gpu-mhz; maximum: 3000; caption: "Frequency"; }
                                Thermometer { value: gpu-temp; }
                                Ring { value: gpu-usage; caption: "Usage"; }
                            }
                        }
                        VerticalLayout {
                            spacing: 8px;
                            SectionHeader {
                                icon: @image-url("icons/sliders.svg");
                                title: "Quick setting";
                            }
                            HorizontalLayout {
                                height: 40px;
                                Text { text: "Items"; color: Theme.accent; font-size: 18px; horizontal-stretch: 1; vertical-alignment: center; }
                                Text { text: "Setting"; color: Theme.accent; font-size: 18px; width: 110px; vertical-alignment: center; }
                            }
                            QuickRow {
                                text: "Speaker mute";
                                checked <=> speaker-mute;
                                toggled(v) => { set-speaker-mute(v); }
                            }
                            QuickRow {
                                text: "Touch pad";
                                checked <=> touchpad;
                                toggled(v) => { set-touchpad(v); }
                            }
                            QuickRow {
                                text: "Windows key";
                                checked <=> win-key;
                                toggled(v) => { set-key(0, v); }
                            }
                            QuickRow {
                                text: "PrtScrn key";
                                checked <=> prtsc-key;
                                toggled(v) => { set-key(2, v); }
                            }
                            QuickRow {
                                text: "Function key";
                                checked <=> fn-key;
                                toggled(v) => { set-key(1, v); }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                }

                // ===== System Information =====
                if page == 1: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 26px;
                    HorizontalLayout {
                        spacing: 26px;
                        height: 70px;
                        Image {
                            source: @image-url("icons/laptop.svg");
                            width: 90px;
                            height: 56px;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: hostname;
                            color: Theme.text;
                            font-size: 26px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    GridLayout {
                        spacing-horizontal: 30px;
                        spacing-vertical: 30px;
                        Row {
                            Text { text: "Computer model"; color: Theme.text; font-size: 17px; vertical-alignment: center; }
                            Text { text: model; color: Theme.text; font-size: 17px; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                            Text { text: "Operation system"; color: Theme.text; font-size: 17px; vertical-alignment: center; }
                            Text { text: os; color: Theme.text; font-size: 17px; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                        }
                        Row {
                            Text { text: "CPU"; color: Theme.text; font-size: 17px; vertical-alignment: center; }
                            Text { text: cpu-name; color: Theme.text; font-size: 17px; vertical-alignment: center; wrap: word-wrap; }
                            Text { text: "CPU Temperature"; color: Theme.text; font-size: 17px; vertical-alignment: center; }
                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: Math.round(cpu-temp) + "°C"; color: Theme.text; font-size: 17px; vertical-alignment: center; width: 60px; }
                                Rectangle {
                                    height: 6px;
                                    y: (parent.height - self.height) / 2;
                                    max-width: 260px;
                                    border-radius: 3px;
                                    background: #6d7577;
                                    Rectangle { x: 0; width: parent.width * Math.min(1, cpu-temp / 100); border-radius: 3px; background: #23b43c; }
                                }
                            }
                        }
                        Row {
                            Text { text: "GPU"; color: Theme.text; font-size: 17px; vertical-alignment: center; }
                            Text { text: gpu-name; color: Theme.text; font-size: 17px; vertical-alignment: center; wrap: word-wrap; }
                            Text { text: "GPU Temperature"; color: Theme.text; font-size: 17px; vertical-alignment: center; }
                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: Math.round(gpu-temp) + "°C"; color: Theme.text; font-size: 17px; vertical-alignment: center; width: 60px; }
                                Rectangle {
                                    height: 6px;
                                    y: (parent.height - self.height) / 2;
                                    max-width: 260px;
                                    border-radius: 3px;
                                    background: #6d7577;
                                    Rectangle { x: 0; width: parent.width * Math.min(1, gpu-temp / 100); border-radius: 3px; background: #23b43c; }
                                }
                            }
                        }
                        Row {
                            Text { text: "Mainboard"; color: Theme.text; font-size: 17px; vertical-alignment: center; }
                            Text { text: board; color: Theme.text; font-size: 17px; vertical-alignment: center; }
                            Text { text: "Memory"; color: Theme.text; font-size: 17px; vertical-alignment: center; }
                            Text { text: memory-size; color: Theme.text; font-size: 17px; vertical-alignment: center; }
                        }
                        Row {
                            Text { text: "Display"; color: Theme.text; font-size: 17px; vertical-alignment: center; }
                            Text { text: display; color: Theme.text; font-size: 17px; vertical-alignment: center; }
                            Text { text: "Storage"; color: Theme.text; font-size: 17px; vertical-alignment: center; }
                            Text { text: storage-size; color: Theme.text; font-size: 17px; vertical-alignment: center; }
                        }
                        Row {
                            Text { text: "Audio card"; color: Theme.text; font-size: 17px; vertical-alignment: center; }
                            Text { text: audio; color: Theme.text; font-size: 17px; vertical-alignment: center; wrap: word-wrap; }
                            Text { text: "Network card"; color: Theme.text; font-size: 17px; vertical-alignment: center; }
                            Text { text: network; color: Theme.text; font-size: 17px; vertical-alignment: center; wrap: word-wrap; }
                        }
                        Row {
                            Text { text: "Battery capacity"; color: Theme.text; font-size: 17px; vertical-alignment: center; }
                            Text { text: battery-capacity; color: Theme.text; font-size: 17px; vertical-alignment: center; }
                            Text { text: "Battery level"; color: Theme.text; font-size: 17px; vertical-alignment: center; }
                            Text { text: battery-level; color: Theme.text; font-size: 17px; vertical-alignment: center; }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                // ===== Lighting Setting =====
                if page == 2: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 14px;
                    HorizontalLayout {
                        spacing: 12px;
                        PillButton {
                            text: "Light bar Left";
                            icon: @image-url("icons/lightbar.svg");
                            has-icon: true;
                            min-height: 42px;
                            width: 230px;
                            selected: selected-zone == 4;
                            glow: bars[0];
                            icon-colour: light-on ? bars[0] : Theme.muted;
                            clicked => { paint-target(4); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        for name[i] in ["Rainbow", "Ocean", "Sunset", "Forest", "White"]: PillButton {
                            text: name;
                            min-height: 42px;
                            min-width: 86px;
                            selected: preset == i;
                            clicked => { set-preset(i); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        PillButton {
                            text: "Light bar Right";
                            icon: @image-url("icons/lightbar.svg");
                            has-icon: true;
                            min-height: 42px;
                            width: 230px;
                            selected: selected-zone == 5;
                            glow: bars[1];
                            icon-colour: light-on ? bars[1] : Theme.muted;
                            clicked => { paint-target(5); }
                        }
                    }
                    KeyboardView {
                        vertical-stretch: 3;
                        keys: keys;
                        zones: zones;
                        lit: light-on;
                        brightness: brightness;
                        effect: effect;
                        speed: speed;
                        selected: effect == 0 ? selected-zone : -2;
                        animate-preview: page == 2;
                        key-clicked(z) => { paint-target(z); }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: "My presets";
                            color: Theme.accent;
                            font-size: 16px;
                            vertical-alignment: center;
                        }
                        for name[i] in user-presets: UserPresetChip {
                            text: name;
                            selected: user-preset == i;
                            clicked => { apply-user-preset(i); }
                            deleted => { delete-user-preset(i); }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: effect == 5 || effect == 6 || effect == 8 ? "This effect lights the keys you press, so the keyboard looks dark until you type."
                                : user-presets.length == 0 ? "Changes apply as you make them. Like a look? Save it as a preset."
                                : "";
                            color: Theme.muted;
                            font-size: 13px;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                        PillButton { text: "Default"; width: 150px; clicked => { lighting-default(); } }
                        PillButton {
                            text: "Save as preset";
                            width: 180px;
                            clicked => { save-popup.show(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 50px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 10px;
                            SectionHeader { icon: @image-url("icons/sun.svg"); title: "Backlight Control"; }
                            HorizontalLayout {
                                height: 46px;
                                Text { text: "Keyboard light"; color: Theme.text; font-size: 17px; width: 200px; vertical-alignment: center; }
                                Toggle {
                                    checked <=> light-on;
                                    toggled(v) => { set-light-on(v); }
                                }
                            }
                            HorizontalLayout {
                                height: 46px;
                                Text { text: "Brightness"; color: Theme.text; font-size: 17px; width: 200px; vertical-alignment: center; }
                                Slider {
                                    minimum: 1;
                                    maximum: 10;
                                    value: brightness;
                                    released(v) => {
                                        brightness = Math.round(v);
                                        set-brightness(brightness);
                                    }
                                }
                            }
                            HorizontalLayout {
                                height: 46px;
                                Text { text: "Speed"; color: Theme.text; font-size: 17px; width: 200px; vertical-alignment: center; }
                                Slider {
                                    minimum: 1;
                                    maximum: 10;
                                    value: speed;
                                    enabled: effect != 0;
                                    released(v) => {
                                        speed = Math.round(v);
                                        set-speed(speed);
                                    }
                                }
                            }
                            HorizontalLayout {
                                height: 46px;
                                Text { text: "Keyboard sleep time"; color: Theme.text; font-size: 17px; width: 200px; vertical-alignment: center; }
                                ComboBox {
                                    model: ["1 minute", "5 minutes", "10 minutes", "15 minutes", "20 minutes", "30 minutes", "1 hour", "2 hours", "Never"];
                                    current-index <=> sleep-index;
                                    selected => { set-sleep(self.current-index); }
                                }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1.4;
                            spacing: 10px;
                            SectionHeader { icon: @image-url("icons/effect.svg"); title: "Effect Setting"; }
                            HorizontalLayout {
                                spacing: 28px;
                                VerticalLayout {
                                    spacing: 10px;
                                    ColourWheel {
                                        vertical-stretch: 1;
                                        colour: current-colour;
                                        picked(c) => {
                                            current-colour = c;
                                            set-colour(c);
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: center;
                                        r := RgbBox { text: current-colour.red; accepted => { rgb-entered(r.text, g.text, b.text); } }
                                        g := RgbBox { text: current-colour.green; accepted => { rgb-entered(r.text, g.text, b.text); } }
                                        b := RgbBox { text: current-colour.blue; accepted => { rgb-entered(r.text, g.text, b.text); } }
                                    }
                                }
                                GridLayout {
                                    horizontal-stretch: 1;
                                    spacing: 14px;
                                    Row {
                                        PillButton { text: "Always"; selected: effect == 0; clicked => { set-effect(0); } }
                                        PillButton { text: "Breath"; selected: effect == 3; clicked => { set-effect(3); } }
                                        PillButton { text: "Rainbow"; selected: effect == 7; clicked => { set-effect(7); } }
                                    }
                                    Row {
                                        PillButton { text: "Ripple"; selected: effect == 6; clicked => { set-effect(6); } }
                                        PillButton { text: "Cycle"; selected: effect == 4; clicked => { set-effect(4); } }
                                        PillButton { text: "Twinkle"; selected: effect == 1; clicked => { set-effect(1); } }
                                    }
                                    Row {
                                        PillButton { text: "Wave"; selected: effect == 2; clicked => { set-effect(2); } }
                                        PillButton { text: "Reactive"; selected: effect == 5; clicked => { set-effect(5); } }
                                        PillButton { text: "Rainbow ripple"; font-size: 13px; selected: effect == 8; clicked => { set-effect(8); } }
                                    }
                                }
                            }
                        }
                    }
                }

                // ===== Power Mode =====
                if page == 3: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 18px;
                    SectionHeader { icon: @image-url("icons/fan-outline.svg"); title: "Fan"; }
                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 20px;
                        FanDial { rpm: fan1; caption: "Fan 1"; }
                        VerticalLayout {
                            alignment: center;
                            spacing: 18px;
                            SpeedCard { title: "Fan 1 rotating speed"; rpm: fan1; }
                            SpeedCard { title: "Fan 2 rotating speed"; rpm: fan2; }
                        }
                        FanDial { rpm: fan2; caption: "Fan 2"; }
                    }
                    SectionHeader { icon: @image-url("icons/mode.svg"); title: "Mode"; }
                    HorizontalLayout {
                        spacing: 60px;
                        padding-left: 60px;
                        padding-right: 60px;
                        PillButton {
                            text: "Quiet";
                            min-height: 76px;
                            horizontal-stretch: 1;
                            selected: profile == 0;
                            clicked => { set-profile(0); }
                        }
                        PillButton {
                            text: "Balanced";
                            min-height: 76px;
                            horizontal-stretch: 1;
                            selected: profile == 1;
                            clicked => { set-profile(1); }
                        }
                        PillButton {
                            text: "High Performance";
                            min-height: 76px;
                            horizontal-stretch: 1;
                            selected: profile == 2;
                            clicked => { set-profile(2); }
                        }
                    }
                    Text {
                        text: profile == 0 ? "Quiet: about 55 W sustained on AC, quietest fans."
                            : profile == 1 ? "Balanced: about 90 W sustained on AC."
                            : "High Performance: about 132 W sustained on AC (battery above 50 %). On battery every mode is limited to about 30 W.";
                        color: Theme.muted;
                        font-size: 13px;
                        horizontal-alignment: center;
                    }
                    SectionHeader { icon: @image-url("icons/battery.svg"); title: "Battery charge limit"; }
                    HorizontalLayout {
                        spacing: 24px;
                        padding-left: 6px;
                        Toggle {
                            width: 110px;
                            checked <=> limit-charge;
                            toggled(v) => { set-charge-limit(v, charge-limit); }
                        }
                        Text {
                            text: limit-charge ? "Stop charging at " + charge-limit + " %" : "Charging to 100 %";
                            color: Theme.text;
                            font-size: 17px;
                            vertical-alignment: center;
                            width: 240px;
                        }
                        Slider {
                            horizontal-stretch: 1;
                            enabled: limit-charge;
                            minimum: 50;
                            maximum: 95;
                            value: charge-limit;
                            released(v) => {
                                charge-limit = Math.round(v / 5) * 5;
                                set-charge-limit(true, charge-limit);
                            }
                        }
                    }
                }

                Text {
                    text: status;
                    color: #ffb4bc;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }
    }

    save-popup := PopupWindow {
        x: (root.width - 420px) / 2;
        y: (root.height - 190px) / 2;
        width: 420px;
        height: 190px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.panel;
            border-radius: 16px;
            border-width: 1.5px;
            border-color: Theme.accent-dim;
            drop-shadow-blur: 30px;
            drop-shadow-color: #000c;
            VerticalLayout {
                padding: 22px;
                spacing: 14px;
                Text {
                    text: "Save this look as a preset";
                    color: Theme.text;
                    font-size: 18px;
                }
                preset-name := LineEdit {
                    placeholder-text: "Name, e.g. Gaming";
                    init => { self.focus(); }
                    accepted(t) => {
                        save-preset(t);
                        save-popup.close();
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;
                    PillButton {
                        text: "Cancel";
                        min-height: 40px;
                        width: 120px;
                        clicked => { save-popup.close(); }
                    }
                    PillButton {
                        text: "Save";
                        min-height: 40px;
                        width: 120px;
                        selected: true;
                        clicked => {
                            save-preset(preset-name.text);
                            save-popup.close();
                        }
                    }
                }
            }
        }
    }

}
